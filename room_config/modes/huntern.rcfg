# Tee Asylum: random melee, ranged and utility on every spawn
map hunter2
scorelimit 25
timelimit 10
warmup 0
powerups 0
minimum_players 2
tournament_chat 0
asylum_respawn_delay 2
asylum_spawn_protection 1
asylum_spawn_armor 2

add_vote " " "info"
add_vote "=== TEE ASYLUM 随机武器PVP ===" "info"
add_vote "Restart" "restart"
add_vote "10 minute / 25 kills" "scorelimit 25;timelimit 10"
add_vote "15 minute / 50 kills" "scorelimit 50;timelimit 15"
add_vote "Unlimited time" "timelimit 0"
add_tagged_map_vote 60
add_tagged_map_vote 3
